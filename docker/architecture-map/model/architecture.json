{
  "schema_version": "1.0.0",
  "title": "Homelab Data Flow",
  "boundaries": [
    {"id": "external", "name": "External systems", "order": 1},
    {"id": "edge", "name": "Edge node · piaware", "order": 2},
    {"id": "brain", "name": "Controller · brain", "order": 3},
    {"id": "stores", "name": "Persistent data", "order": 4}
  ],
  "nodes": [
    {"id":"operator","name":"Operator","type":"entity","boundary":"external","summary":"LAN browser, SSH, Ansible, and manual release initiator","endpoint":"Trusted LAN / SSH"},
    {"id":"github","name":"GitHub","type":"entity","boundary":"external","summary":"Source repository, Actions control plane, and Aikido integration surface","endpoint":"github.com"},
    {"id":"ecowitt","name":"Weather station","type":"entity","boundary":"external","summary":"Physical Ecowitt gateway reporting local weather observations","endpoint":"HTTP → brain:8000"},
    {"id":"iphone","name":"iPhone","type":"entity","boundary":"external","summary":"Authenticated ntfy subscriber on the trusted LAN","endpoint":"HTTP → brain:8093"},
    {"id":"aircraft","name":"Aircraft signals","type":"entity","boundary":"external","summary":"1090 MHz radio broadcasts received locally","endpoint":"RF / 1090 MHz"},

    {"id":"decoder","name":"PiAware decoder","type":"process","boundary":"edge","summary":"Decodes ADS-B traffic and feeds the local aircraft map","endpoint":"piaware"},
    {"id":"piaware-metrics","name":"Pi metrics exporter","type":"process","boundary":"edge","summary":"Publishes privacy-safe receiver and hardware metrics","endpoint":"192.168.1.27:9100"},
    {"id":"skyaware","name":"SkyAware","type":"process","boundary":"edge","summary":"Serves the local aircraft map","endpoint":"192.168.1.27/skyaware"},

    {"id":"homepage","name":"Homepage","type":"process","boundary":"brain","summary":"Primary LAN control surface and current-status summary","endpoint":"brain:3000"},
    {"id":"collector","name":"Telemetry Collector","type":"process","boundary":"brain","summary":"Validates and normalizes Ecowitt observations","endpoint":"brain:8000"},
    {"id":"grafana","name":"Grafana","type":"process","boundary":"brain","summary":"Queries metrics, logs, and telemetry for dashboards","endpoint":"brain:3001"},
    {"id":"prometheus","name":"Prometheus","type":"process","boundary":"brain","summary":"Scrapes metrics, probes availability, and evaluates alert rules","endpoint":"brain:9090"},
    {"id":"alertmanager","name":"Alertmanager","type":"process","boundary":"brain","summary":"Groups, inhibits, and routes firing and resolved alerts","endpoint":"brain:9093"},
    {"id":"alloy","name":"Alloy","type":"process","boundary":"brain","summary":"Collects constrained Docker logs through a read-only proxy","endpoint":"Container-private"},
    {"id":"inventory","name":"Network Inventory","type":"process","boundary":"brain","summary":"Discovers LAN devices and maintains observed identities","endpoint":"brain:8030"},
    {"id":"study","name":"Study Deck","type":"process","boundary":"brain","summary":"Serves interview practice and records personal progress","endpoint":"brain:8020"},
    {"id":"ntfy","name":"ntfy","type":"process","boundary":"brain","summary":"Authenticated LAN notification broker with iOS wake-up relay","endpoint":"brain:8093"},
    {"id":"runner","name":"Actions runner","type":"process","boundary":"brain","summary":"Executes validation and manually triggered deployments","endpoint":"Host service"},

    {"id":"influx","name":"InfluxDB","type":"store","boundary":"stores","summary":"Durable normalized weather time series","endpoint":"Volume · brain:8086"},
    {"id":"prom-tsdb","name":"Prometheus TSDB","type":"store","boundary":"stores","summary":"Retained metrics and alert evaluation history","endpoint":"Named volume"},
    {"id":"loki","name":"Loki","type":"store","boundary":"stores","summary":"Retained constrained container logs","endpoint":"Volume · brain:3100"},
    {"id":"inventory-db","name":"Inventory SQLite","type":"store","boundary":"stores","summary":"Observations, confirmation state, and device identities","endpoint":"Named volume"},
    {"id":"study-db","name":"Study progress","type":"store","boundary":"stores","summary":"Local quiz progress separate from Git-managed content","endpoint":"Named volume"},
    {"id":"ntfy-db","name":"ntfy state","type":"store","boundary":"stores","summary":"Message cache, authentication, and access control","endpoint":"Named volume"},
    {"id":"releases","name":"Immutable releases","type":"store","boundary":"stores","summary":"Versioned Homepage releases with last-known-good rollback","endpoint":"/srv/homelab/homepage"}
  ],
  "flows": [
    {"from":"operator","to":"homepage","category":"access","label":"Browse control surface","protocol":"HTTP"},
    {"from":"operator","to":"runner","category":"deployment","label":"Trigger manual deployment","protocol":"GitHub Actions"},
    {"from":"github","to":"runner","category":"deployment","label":"Dispatch job and source","protocol":"HTTPS"},
    {"from":"runner","to":"releases","category":"deployment","label":"Stage, verify, activate, or roll back","protocol":"Filesystem + Compose"},
    {"from":"ecowitt","to":"collector","category":"telemetry","label":"Weather report","protocol":"HTTP / Ecowitt"},
    {"from":"collector","to":"influx","category":"telemetry","label":"Normalized measurements","protocol":"Influx line protocol"},
    {"from":"grafana","to":"influx","category":"telemetry","label":"Weather queries","protocol":"Flux / HTTP"},
    {"from":"homepage","to":"collector","category":"telemetry","label":"Latest weather summary","protocol":"HTTP API"},
    {"from":"aircraft","to":"decoder","category":"adsb","label":"Aircraft broadcasts","protocol":"1090 MHz RF"},
    {"from":"decoder","to":"skyaware","category":"adsb","label":"Decoded aircraft state","protocol":"Local feed"},
    {"from":"decoder","to":"piaware-metrics","category":"adsb","label":"Receiver statistics","protocol":"Local files"},
    {"from":"prometheus","to":"piaware-metrics","category":"observability","label":"Scrape receiver and Pi metrics","protocol":"Prometheus HTTP"},
    {"from":"prometheus","to":"collector","category":"observability","label":"Scrape collector metrics","protocol":"Prometheus HTTP"},
    {"from":"prometheus","to":"homepage","category":"observability","label":"Probe availability","protocol":"Blackbox HTTP"},
    {"from":"prometheus","to":"prom-tsdb","category":"observability","label":"Store samples","protocol":"Local TSDB"},
    {"from":"prometheus","to":"alertmanager","category":"notification","label":"Firing and resolved alerts","protocol":"HTTP"},
    {"from":"alertmanager","to":"ntfy","category":"notification","label":"Grouped alert delivery","protocol":"Authenticated webhook"},
    {"from":"inventory","to":"ntfy","category":"notification","label":"Confirmed unknown device","protocol":"Authenticated HTTP"},
    {"from":"ntfy","to":"iphone","category":"notification","label":"Notification delivery","protocol":"APNS wake-up + private fetch"},
    {"from":"ntfy","to":"ntfy-db","category":"notification","label":"Cache and authorization state","protocol":"SQLite"},
    {"from":"alloy","to":"loki","category":"logging","label":"Constrained container logs","protocol":"Loki push API"},
    {"from":"grafana","to":"loki","category":"logging","label":"Log queries","protocol":"LogQL / HTTP"},
    {"from":"grafana","to":"prometheus","category":"observability","label":"Metrics queries","protocol":"PromQL / HTTP"},
    {"from":"inventory","to":"inventory-db","category":"inventory","label":"Observations and identities","protocol":"SQLite"},
    {"from":"study","to":"study-db","category":"study","label":"Quiz progress","protocol":"SQLite"},
    {"from":"homepage","to":"grafana","category":"access","label":"Dashboard links","protocol":"HTTP"},
    {"from":"homepage","to":"inventory","category":"access","label":"Inventory link and health","protocol":"HTTP"},
    {"from":"homepage","to":"study","category":"access","label":"Study link and health","protocol":"HTTP"},
    {"from":"homepage","to":"skyaware","category":"access","label":"Aircraft map link","protocol":"HTTP"}
  ]
}
