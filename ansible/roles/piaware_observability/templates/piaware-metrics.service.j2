[Unit]
Description=Export privacy-safe aggregate PiAware metrics
After=dump1090-fa.service

[Service]
Type=oneshot
User=root
Group=root
ExecStart=/usr/local/sbin/piaware-export-metrics --aircraft-json {{ piaware_aircraft_json }} --receiver-json {{ piaware_receiver_json }} --country-ranges {{ piaware_country_ranges }} --output {{ piaware_metrics_file }}
NoNewPrivileges=true
PrivateTmp=true
ProtectHome=true
ProtectSystem=strict
ReadWritePaths={{ piaware_textfile_directory }}
